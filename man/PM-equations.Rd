\section{Status}{

\code{PM_FFMSY}: fishing mortality relative to \eqn{F_{MSY}}{FMSY},
\deqn{F_{s,y} / F_{MSY,s}}{F[s,y] / FMSY[s]}
with the probability metric \eqn{P(F/F_{MSY} < Ref)}{P(F/FMSY < Ref)}.

\code{PM_SBSBMSY} / \code{PM_SPSPMSY}: spawning biomass or spawning production
relative to its value at MSY,
\deqn{SB_{s,y} / SB_{MSY,s} \quad\text{or}\quad SP_{s,y} / SP_{MSY,s}}{SB[s,y] / SBMSY[s]  or  SP[s,y] / SPMSY[s]}
with the probability metric \eqn{P(SB/SB_{MSY} > Ref)}{P(SB/SBMSY > Ref)}
(or the SP equivalent).

\code{PM_Status}: the joint probability that a complex is neither overfished
nor experiencing overfishing,
\deqn{P\left(\frac{SB_{y}}{SB_{MSY}} > 1 \ \text{and}\ \frac{F_{y}}{F_{MSY}} < 1\right)}{P( SB/SBMSY > 1  and  F/FMSY < 1 )}
evaluated at the complex level, where \code{SB} is spawning biomass or spawning
production according to \code{Definition}.

\code{PM_Kobe}: the probability of being in a quadrant of the Kobe plot, e.g.
for the red quadrant,
\deqn{P\left(\frac{SB_{y}}{SB_{MSY}} < 1 \ \text{and}\ \frac{F_{y}}{F_{MSY}} > 1\right)}{P( SB/SBMSY < 1  and  F/FMSY > 1 )}
(see \link{PM} for the definition of each quadrant).

\code{PM_MinStatus}: the lowest annual stock status over the evaluation window,
\deqn{\min_{y \in Y} \frac{SB_{s,y}}{SB_{ref,s}}}{min over y in Y of SB[s,y] / SBref[s]}
where \eqn{SB_{ref}}{SBref} is \eqn{SB_{MSY}}{SBMSY} or \eqn{SB_0}{SB0}
according to \code{Reference}.
}

\section{Safety}{

\code{PM_SBSBlim} / \code{PM_SPSPlim}: spawning biomass or spawning production
relative to MSY, relative in turn to a limit fraction \code{Lim} of \code{SBMSY}/
\code{SPMSY},
\deqn{\frac{SB_{s,y}/SB_{MSY,s}}{Lim_s} \quad\text{or}\quad \frac{SP_{s,y}/SP_{MSY,s}}{Lim_s}}{(SB[s,y]/SBMSY[s]) / Lim[s]  or  (SP[s,y]/SPMSY[s]) / Lim[s]}
with the probability metric \eqn{P(\frac{SB/SB_{MSY}}{Lim} > 1)}{P((SB/SBMSY)/Lim > 1)}
(or the SP equivalent) -- i.e. the probability that \code{SB/SBMSY} exceeds
