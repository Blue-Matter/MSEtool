\subsection{Model listing}{

\code{SRRModels()} prints or returns the set of stock–recruitment models
available in the package.
}

\subsection{Parameterisation}{

In \code{\link[=SRR]{SRR()}}, \code{Pars} for \code{BevertonHolt} and \code{Ricker} may be given either as
steepness (\code{list(h = ...)} or \code{list(hR = ...)}, with \code{R0}) or as
\code{list(alpha = ..., beta = ...)} with \code{R0 = NULL}. Alpha-beta values are
converted to steepness and \code{R0} during \code{\link[=Populate]{Populate()}} using the first-year
unfished spawning production per recruit \eqn{\phi_0}. See \code{\link[=SRRSteepness]{SRRSteepness()}}
for the conversion.
}

\subsection{Beverton–Holt}{
\itemize{
\item \code{BevertonHolt()} evaluates expected recruitment:
\deqn{R = \frac{\alpha S}{1 + \beta S}}
where \eqn{\phi_0 = S_0 / R_0},
\eqn{\alpha = 4h / ((1 - h)\phi_0)}, and
\eqn{\beta = (5h - 1) / ((1 - h)\phi_0 R_0)}.
\item \code{BevertonHolt_RelRec()} evaluates equilibrium recruitment relative to unfished
recruitment as a function of SPR.
}
}

\subsection{Ricker}{
\itemize{
\item \code{Ricker()} evaluates expected recruitment:
\deqn{R = \alpha S e^{-\beta S}}
where \eqn{\alpha = (5h_R)^{1.25} / \phi_0} and
\eqn{\beta = \log((5h_R)^{1.25}) / (\phi_0 R_0)}.
\item \code{Ricker_RelRec()} evaluates equilibrium relative recruitment as a function
of SPR.
}
}

\subsection{Hockey Stick}{
\itemize{
\item \code{HockeyStick()} evaluates recruitment assuming linear increase up to a hinge
point followed by saturation at \code{R0}:
\deqn{R = \begin{cases}
\frac{R0}{Shinge} S, & S < Shinge \\
R0, & S \ge Shinge
\end{cases}}
\item \code{HockeyStick_RelRec()} evaluates relative equilibrium recruitment as a
function of SPR.
}
}

\subsection{SurvivalSRR}{
\itemize{
\item \code{SurvivalSRR()} evaluates the survival-based relationship of Taylor et al.
(2013) for low-fecundity species, where \code{S} is the number of offspring
(e.g., pups) and recruitment is offspring times pre-recruit survival:
\deqn{R = S e^{z}, \quad z = z_0 + (z_{min} - z_0)\left(1 - (S/S_0)^{\beta}\right)}
where \eqn{z_0 = \log(R_0 / S_0) = -\log\phi_0} and
\eqn{z_{min} = z_0 (1 - z_{frac})}. Recruitment cannot exceed \code{S}
when \eqn{\phi_0 > 1}. When several stocks recruit from the same
spawning production (e.g., the sexes of a two-sex model), each stock
receives a fraction \code{RecFrac} of the recruits, and \eqn{\phi_0} is the
spawning production per total recruit: \eqn{R = RecFrac\, S e^{z}} with
\eqn{z_0 = \log(R_0 / (RecFrac\, S_0))}, where \code{R0} is the stock's own
unfished recruitment. In an operating model, \code{RecFrac} is the stock's
share of the summed \code{R0} of all stocks with the same \code{SPFrom} source(s)
and weights.
\item \code{SurvivalSRR_RelRec()} evaluates equilibrium relative recruitment as a
function of SPR. It requires \code{Pars$SPR0}, the unfished spawning production
per recruit of the stock; \eqn{\phi_0} is \code{RecFrac * SPR0}:
\deqn{R/R_0 = \frac{1}{SPR}\left(1 + \frac{\log SPR}{z_{frac}\log\phi_0}\right)^{1/\beta}}
and 0 when the term in brackets is not positive.
}
}
}
\examples{

## Compare stock–recruitment relationships

R0 <- 1000
S0 <- 1000
h <- 0.8
Shinge <- 0.2
S <- seq(0, S0, length.out = 200)

R_bh <- BevertonHolt(S, S0, R0, h)
R_rk <- Ricker(S, S0, R0, hR = h)
R_hs <- HockeyStick(S, S0, R0, Shinge)

plot(S, R_bh, type = "l", lwd = 2,
     ylim = c(0, 1200), xlab = "Spawning biomass (S)",
     ylab = "Recruitment")
lines(S, R_rk, lwd = 2, lty = 2)
lines(S, R_hs, lwd = 2, lty = 3)
abline(h=h*R0, lty=3)
abline(v=0.2*S0, lty=3)
legend("bottomright",
       legend = c("Beverton–Holt", "Ricker", "Hockey Stick"),
       lty = c(1, 2, 3), lwd = 2, bty = "n")


## Compare relative equilibrium recruitment vs SPR
SPR <- seq(0, 1, length.out = 200)

Pars_bh <- list(h = h)
Pars_rk <- list(hR = h)
Pars_hs <- list(Shinge = Shinge)

RR_bh <- sapply(SPR, BevertonHolt_RelRec, Pars = Pars_bh)
RR_rk <- sapply(SPR, Ricker_RelRec, Pars = Pars_rk)
RR_hs <- sapply(SPR, HockeyStick_RelRec, Pars = Pars_hs)

plot(SPR, RR_bh, type = "l", lwd = 2,
     ylim = c(0, 1.05), xlab = "SPR",
     ylab = "Relative recruitment (R / R0)")
lines(SPR, RR_rk, lwd = 2, lty = 2)
lines(SPR, RR_hs, lwd = 2, lty = 3)
legend("bottomright",
       legend = c("Beverton–Holt", "Ricker", "Hockey Stick"),
       lty = c(1, 2, 3), lwd = 2, bty = "n")


}
